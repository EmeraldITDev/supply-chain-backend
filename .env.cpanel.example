# Template for .env on cPanel. Copy to .env and replace every CHANGE_ME with the value
# from Render > supply-chain-backend > Environment (DB_PASSWORD: cPanel > MySQL Databases).
# Settings Render does not set (e.g. PO email recipients) are left out on purpose so the
# code's defaults apply, exactly as in production.

# --- App
APP_NAME="Emerald Industrial CFZE"
APP_ENV=production
APP_KEY=CHANGE_ME
# false on purpose: Render has APP_DEBUG=true, which shows secrets on error pages.
APP_DEBUG=false
APP_URL=https://scm-api.emeraldcfze.com
FRONTEND_URL=https://scm.emeraldcfze.com
APP_TIMEZONE=Africa/Lagos
CORS_ALLOWED_ORIGINS=https://emerald-supply-chain.vercel.app,https://scm.emeraldcfze.com,http://localhost:5173,http://localhost:3000

# --- Logs: storage/logs/laravel-YYYY-MM-DD.log (kept 14 days). Render used stderr/debug.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_SLOW_QUERIES=true
SLOW_QUERY_MS=200
SLOW_REQUEST_MS=1000

# --- Database: cPanel MariaDB 10.6. Keep DB_CONNECTION=mysql ("mariadb" needs MariaDB 10.7+).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=chjsqrmy_scm
DB_USERNAME=chjsqrmy_scm
DB_PASSWORD=CHANGE_ME

# --- Cache, sessions, queue (CACHE_FAST_STORE=apc from Render is left out: APCu is not
# available on shared hosting; the file cache is used instead).
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# --- SAFE MODE while testing on a copy of the data (Render values in brackets).
# At go-live set: MAIL_MAILER=resend, FINANCE_AP_INTEGRATION_ENABLED=true,
# FINANCE_AP_VENDOR_SYNC_ENABLED=true - then package and upload again.
MAIL_MAILER=log
FINANCE_AP_INTEGRATION_ENABLED=false
FINANCE_AP_VENDOR_SYNC_ENABLED=false

# --- Mail (Resend API)
RESEND_API_KEY=CHANGE_ME
MAIL_FROM_ADDRESS=support@emeraldcfze.com
MAIL_FROM_NAME=Emerald_SCM

# --- Files: Amazon S3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=supply-chain-vendor-documents
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3
DOCUMENTS_DISK=s3
SIGNATURES_DISK=s3

# --- Company details on purchase orders
COMPANY_NAME="Emerald Industrial CFZE"
COMPANY_ADDRESS="Plot A10, Calabar Free Trade Zone, Calabar, Cross River 540001 NG"
COMPANY_EMAIL=temitope.lawal@emeraldcfze.com
COMPANY_LOGO_BASE64=CHANGE_ME

# --- Finance AP integration (still on Render; when it moves, set
# FINANCE_AP_BASE_URL=https://financeap-api.emeraldcfze.com)
FINANCE_AP_BASE_URL=https://financeap-backend.onrender.com
FINANCE_AP_API_KEY=CHANGE_ME
FINANCE_AP_INTEGRATION_INBOUND_KEY=CHANGE_ME
FINANCE_AP_WEBHOOK_SECRET=CHANGE_ME
FINANCE_AP_HTTP_TIMEOUT=30
FINANCE_AP_CUTOVER_DATE=2026-06-01

# --- AI assistant
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.6-flash

# --- QuickBooks (add the new redirect URI in the Intuit developer portal before connecting)
QUICKBOOKS_CLIENT_ID=CHANGE_ME
QUICKBOOKS_CLIENT_SECRET=CHANGE_ME
QUICKBOOKS_ENCRYPTION_KEY=CHANGE_ME
QUICKBOOKS_ENVIRONMENT=production
QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting
QUICKBOOKS_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com
QUICKBOOKS_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
QUICKBOOKS_REDIRECT_URI=https://scm-api.emeraldcfze.com/api/quickbooks/callback
